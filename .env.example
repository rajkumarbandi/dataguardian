# DataGuardian — Local Development Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your workspace-specific values
#   3. NEVER commit .env to version control (.gitignore already excludes it)
#   4. In production (Databricks), all secrets are stored in Azure Key Vault and
#      accessed via Databricks secret scopes — this file is for local development only.
#
# ─────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------------------
# Target Environment
# ---------------------------------------------------------------------------

# Which environment to target: dev | qa | prod
DATAGUARDIAN_ENV=dev

# ---------------------------------------------------------------------------
# Databricks Connection (for local runs using databricks-connect)
# ---------------------------------------------------------------------------

# Your Databricks workspace URL
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net

# Personal access token for your Databricks workspace
# Generate at: User Settings > Developer > Access Tokens
# Required for: CLI authentication, databricks-connect, bundle deploy
DATABRICKS_TOKEN=<your-personal-access-token>

# Databricks cluster ID for databricks-connect (remote Spark execution)
# Use a DBR 14.3 LTS or later cluster with Unity Catalog enabled
DATABRICKS_CLUSTER_ID=<your-cluster-id>

# ---------------------------------------------------------------------------
# Unity Catalog
# ---------------------------------------------------------------------------

# The catalog name for your target environment
# Convention: dg_dev | dg_qa | dg_prod
DATAGUARDIAN_CATALOG=dg_dev

# ---------------------------------------------------------------------------
# Azure Data Lake Gen2 (ADLS)
# ---------------------------------------------------------------------------

# Storage account name (without .dfs.core.windows.net)
ADLS_ACCOUNT_NAME=<your-storage-account>

# Container name for this environment
ADLS_CONTAINER=dataguardian-dev

# Full ABFSS root path (constructed from above values)
# Example: abfss://dataguardian-dev@myaccount.dfs.core.windows.net
ADLS_ROOT=abfss://${ADLS_CONTAINER}@${ADLS_ACCOUNT_NAME}.dfs.core.windows.net

# ---------------------------------------------------------------------------
# Azure Key Vault
# ---------------------------------------------------------------------------

# Key Vault URI (used for local secret resolution in integration tests)
AZURE_KEYVAULT_URI=https://<your-keyvault-name>.vault.azure.net/

# ---------------------------------------------------------------------------
# Databricks Secret Scope
# ---------------------------------------------------------------------------

# The secret scope that backs the Key Vault for this environment
DATAGUARDIAN_SECRET_SCOPE=dataguardian-dev-scope

# ---------------------------------------------------------------------------
# Azure OpenAI (for AI enrichment features)
# ---------------------------------------------------------------------------

# Set DATAGUARDIAN_AI_ENABLED=false to disable all AI calls (recommended for dev)
DATAGUARDIAN_AI_ENABLED=false

# Azure OpenAI endpoint (leave blank if AI is disabled)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# Azure OpenAI API key (leave blank if AI is disabled)
# In production this is resolved from Key Vault via the secret scope
AZURE_OPENAI_API_KEY=

# Deployment names for your Azure OpenAI models
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
DATAGUARDIAN_LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Local Test Overrides
# ---------------------------------------------------------------------------

# Set to "true" to run integration tests that require a live Spark session
# These are skipped by default in CI (unit tests only)
RUN_INTEGRATION_TESTS=false
